#!/usr/bin/env python3
import argparse
import time
import re
from typing import Dict, Tuple

from netmiko import ConnectHandler
from rpi_ws281x import PixelStrip, Color


# =========================
# LED CONFIG
# =========================
LED_COUNT      = 60
LED_PIN        = 18       # GPIO18 PWM
LED_FREQ_HZ    = 800000
LED_DMA        = 10
LED_BRIGHTNESS = 80
LED_INVERT     = False
LED_CHANNEL    = 0

COLOR_UP      = Color(0, 255, 0)    # gruen
COLOR_DOWN    = Color(255, 0, 0)    # rot
COLOR_OTHER   = Color(0, 0, 80)     # blau
COLOR_OFF     = Color(0, 0, 0)

# Wenn Farben komisch sind (GRB/RGB), sag Bescheid – dann stelle ich STRIP-TYPE um.


# =========================
# LED MAPPING
# =========================
def build_led_map() -> Dict[str, int]:
    m = {}
    idx = 0

    # Gi1/0/1-48 => LED 0..47
    for p in range(1, 49):
        m[f"GigabitEthernet1/0/{p}"] = idx
        idx += 1

    # Gi1/1/1-4 => LED 48..51
    for p in range(1, 5):
        m[f"GigabitEthernet1/1/{p}"] = idx
        idx += 1

    # VLANs => LED 52..53
    m["Vlan10"] = idx; idx += 1
    m["Vlan20"] = idx; idx += 1

    # Frei: 54..59 (z.B. für Net-OK, Fehler etc.)
    m["_SSH_OK"] = 54
    m["_SSH_ERR"] = 55

    return m

LED_MAP = build_led_map()


# =========================
# NAME NORMALIZATION
# =========================
def normalize_ifname(name: str) -> str:
    name = name.strip()

    # Gi1/0/1 => GigabitEthernet1/0/1
    if name.startswith("Gi"):
        return name.replace("Gi", "GigabitEthernet", 1)

    # Te1/1/1 => TenGigabitEthernet1/1/1 (falls mal vorhanden)
    if name.startswith("Te"):
        return name.replace("Te", "TenGigabitEthernet", 1)

    # Vl10 => Vlan10 (falls mal so kommt)
    if name.startswith("Vl"):
        return name.replace("Vl", "Vlan", 1)

    return name


# =========================
# LED HELPERS
# =========================
def init_strip() -> PixelStrip:
    strip = PixelStrip(LED_COUNT, LED_PIN, LED_FREQ_HZ, LED_DMA, LED_INVERT, LED_BRIGHTNESS, LED_CHANNEL)
    strip.begin()
    # alles aus
    for i in range(LED_COUNT):
        strip.setPixelColor(i, COLOR_OFF)
    strip.show()
    return strip

def set_led(strip: PixelStrip, idx: int, color: int):
    if idx is None or idx < 0 or idx >= LED_COUNT:
        return
    strip.setPixelColor(idx, color)

def set_status_leds(strip: PixelStrip, ok: bool):
    ok_idx = LED_MAP.get("_SSH_OK")
    err_idx = LED_MAP.get("_SSH_ERR")
    if ok:
        set_led(strip, ok_idx, Color(0, 40, 0))
        set_led(strip, err_idx, COLOR_OFF)
    else:
        set_led(strip, ok_idx, COLOR_OFF)
        set_led(strip, err_idx, Color(40, 10, 0))
    strip.show()

def color_for_state(state: str) -> int:
    s = (state or "").strip().lower()

    # UP
    if s in ("connected", "up"):
        return COLOR_UP

    # DOWN (alles, was effektiv nicht link-up ist)
    if s in ("notconnect", "down", "disabled", "err-disabled", "lower-layer-down", "inactive"):
        return COLOR_DOWN

    # sonst
    return COLOR_OTHER


# =========================
# COMMAND FILE LOADER
# =========================
def load_commands(path: str):
    cmds = []
    with open(path, "r", encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            cmds.append(line)
    return cmds


# =========================
# SSH / PARSING
# =========================
def parse_show_interface_status(output: str) -> Dict[str, str]:
    """
    Parses: 'show interface status'
    Returns: { 'GigabitEthernet1/0/1': 'connected|notconnect|disabled|...' }
    """
    result = {}

    # Beispiel-Zeile:
    # Gi1/0/1  name  connected  10  a-full a-100 10/100/1000BaseTX
    # Port      Name               Status       Vlan       Duplex  Speed Type
    lines = [l.rstrip() for l in output.splitlines() if l.strip()]
    for l in lines:
        if l.lower().startswith("port "):
            continue
        if re.match(r"^-+$", l):
            continue

        # split mit mehreren spaces
        parts = re.split(r"\s{2,}|\t+", l.strip())
        if not parts:
            continue

        # erster Token ist Port
        port = parts[0]
        if not (port.startswith("Gi") or port.startswith("Te") or port.startswith("Fa")):
            continue

        # Status ist typischerweise 3. Spalte bei Cisco, aber je nach Name-Feld kann es rutschen.
        # Wir suchen in parts nach einem bekannten Status-Wort:
        status_candidates = {"connected", "notconnect", "disabled", "err-disabled", "inactive"}
        status = None
        for p in parts:
            pl = p.strip().lower()
            if pl in status_candidates:
                status = pl
                break

        if status is None:
            status = "unknown"

        result[normalize_ifname(port)] = status

    return result

def parse_vlan_line_status(output: str) -> Dict[str, str]:
    """
    Parses: 'show ip interface brief'
    Returns VLAN operational status for Vlan10/Vlan20 if present.
    """
    res = {}
    for line in output.splitlines():
        line = line.strip()
        if not line:
            continue
        # Vlan10  192.168.10.1  YES manual up up
        if line.lower().startswith("vlan"):
            parts = re.split(r"\s+", line)
            if len(parts) >= 6:
                name = normalize_ifname(parts[0])
                # parts: Interface, IP, OK?, Method, Status, Protocol
                status = parts[4].lower()
                proto = parts[5].lower()
                oper = "up" if (status == "up" and proto == "up") else "down"
                res[name] = oper
    return res

def apply_leds(strip: PixelStrip, port_states: Dict[str, str], vlan_states: Dict[str, str]):
    # Für alle gemappten Interfaces/VLANs setzen wir default "OTHER"
    for name, idx in LED_MAP.items():
        if name.startswith("_"):
            continue
        set_led(strip, idx, COLOR_OTHER)

    # Ports (Gi..)
    for ifname, state in port_states.items():
        idx = LED_MAP.get(ifname)
        if idx is None:
            continue
        set_led(strip, idx, color_for_state(state))

    # VLANs
    for ifname, state in vlan_states.items():
        idx = LED_MAP.get(ifname)
        if idx is None:
            continue
        # vlan parser liefert "up"/"down"
        set_led(strip, idx, COLOR_UP if state == "up" else COLOR_DOWN)

    strip.show()


# =========================
# MAIN
# =========================
def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--host", required=True)
    ap.add_argument("--user", required=True)
    ap.add_argument("--pass", dest="password", required=True)
    ap.add_argument("--secret", default=None, help="enable secret (falls gebraucht)")
    ap.add_argument("--cmdfile", required=True, help="Textdatei mit Cisco Befehlen")
    ap.add_argument("--device", default="cisco_xe", help="netmiko device_type (cisco_ios/cisco_xe)")
    ap.add_argument("--interval", type=float, default=1.0, help="Polling Sekunden für LED update")
    ap.add_argument("--apply", action="store_true", help="wenn gesetzt: config aus cmdfile wird wirklich angewendet")
    args = ap.parse_args()

    strip = init_strip()

    ssh_params = {
        "device_type": args.device,
        "host": args.host,
        "username": args.user,
        "password": args.password,
        "fast_cli": False,
    }

    while True:
        try:
            conn = ConnectHandler(**ssh_params)
            if args.secret:
                conn.enable()

            set_status_leds(strip, True)

            # 1) Commands file anwenden (optional)
            cmds = load_commands(args.cmdfile)
            if cmds:
                if args.apply:
                    # send_config_set macht config t / end automatisch
                    out = conn.send_config_set(cmds)
                    # optional speichern (wenn in Datei "do write mem" drin ist, dann nicht nötig)
                else:
                    print("DRY-RUN: --apply fehlt, sende KEINE config. (Nur Status LEDs)")
                    print("Datei enthält", len(cmds), "Befehle. Starte mit --apply um anzuwenden.")

            # 2) Echtzeit Loop: Status lesen + LEDs setzen
            while True:
                int_status_out = conn.send_command("show interface status", use_textfsm=False)
                port_states = parse_show_interface_status(int_status_out)

                ip_brief_out = conn.send_command("show ip interface brief", use_textfsm=False)
                vlan_states = parse_vlan_line_status(ip_brief_out)

                apply_leds(strip, port_states, vlan_states)
                time.sleep(args.interval)

        except KeyboardInterrupt:
            # alles aus
            for i in range(LED_COUNT):
                strip.setPixelColor(i, COLOR_OFF)
            strip.show()
            break
        except Exception as e:
            # SSH down / parse / irgendwas -> Status LED an
            set_status_leds(strip, False)
            time.sleep(2.0)

if __name__ == "__main__":
    main()
